# Staging environment template. Real values belong in whatever secrets
# mechanism the staging host provides (Render's dashboard env vars today —
# see render.yaml — or a managed secrets store like Doppler/AWS Secrets
# Manager later), not in a committed or even a long-lived local file. Never
# copy values from `.env`/`.env.example` (development) into this — dev and
# staging must not share secrets.

# --- Core ---
ENVIRONMENT=staging
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be unique to staging — never reused from development or production.
# Settings rejects staging/production booting on dev's placeholder value.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# On Render, this file isn't used at all — DATABASE_URL is populated
# automatically from the `caplink-staging-db` database declared in
# render.yaml (Technical Implementation Plan step 1.a.iv) once that
# blueprint is synced, real password included, never touching git or this
# file. This template is only for self-hosting staging somewhere else.
# Prefer the pooled/PgBouncer connection string over the direct one if your
# host offers one (Render's database dashboard shows both, under
# "Connection Pooling", once the database exists).
# pip install -r requirements-postgres.txt on this host before first run.
DATABASE_URL=postgresql://caplink_staging:password@staging-db-host:5432/caplink_staging

# Settings (app/core/config.py) rejects a sqlite:// URL in staging just like
# production, confirmed against the real caplink-staging-db deploy — no
# leniency here, unlike earlier in this project's history.

# --- CORS (comma separated) ---
CORS_ORIGINS=https://staging.caplink.io

# --- Payments (Stripe test-mode keys for staging) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLATFORM_FEE_PERCENT=12.5

# --- Push notifications (mobile) ---
FIREBASE_CREDENTIALS_JSON=./firebase-service-account-staging.json

# --- Observability ---
LOG_LEVEL=INFO
# Real Sentry project needed (see .env.production.example's note) — leave
# empty until one exists.
SENTRY_DSN=

# --- Multi-tenant licensing ---
DEFAULT_UNIVERSITY_TRIAL_DAYS=30
