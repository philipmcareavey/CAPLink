# Production environment template. Real production secrets should not live
# in a committed or even a local `.env.production` file long-term — this
# template exists to document the required shape; the actual values belong
# in a managed secrets store (see Technical Implementation Plan step 1.a.ii)
# or the host platform's own env-var UI (e.g. Render's environment groups,
# as render.yaml already does today for SECRET_KEY/DATABASE_URL/CORS_ORIGINS).
# Settings (app/core/config.py) loads `.env.production` automatically when
# ENVIRONMENT=production, but happily falls back to process env vars if no
# such file exists on disk — which is how the current Render deployment works.

# --- Core ---
ENVIRONMENT=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be unique to production — never reused from development or staging.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# Postgres required — Settings rejects a sqlite:// URL in production, no
# exceptions (unlike staging). render.yaml has a ready-to-uncomment
# `caplink-production-db` block (Technical Implementation Plan step 1.a.iv)
# that populates this automatically once a real production service exists
# and that block is uncommented + synced — this file is only for a
# production host that isn't Render, or for documenting the required shape.
# Prefer the pooled/PgBouncer connection string over the direct one if your
# host offers one.
# pip install -r requirements-postgres.txt on this host before first run.
DATABASE_URL=postgresql://caplink_production:password@prod-db-host:5432/caplink_production

# --- CORS (comma separated) ---
CORS_ORIGINS=https://app.caplink.io

# --- Payments (Stripe LIVE keys — never test keys in production) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLATFORM_FEE_PERCENT=12.5

# --- Push notifications (mobile) ---
FIREBASE_CREDENTIALS_JSON=./firebase-service-account-production.json

# --- Multi-tenant licensing ---
DEFAULT_UNIVERSITY_TRIAL_DAYS=30
