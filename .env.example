# Development environment template (copy to `.env`). For staging/production,
# use `.env.staging.example` / `.env.production.example` instead — Settings
# (app/core/config.py) picks the right file automatically from ENVIRONMENT,
# and rejects dev's placeholder SECRET_KEY/DATABASE_URL outside development.

# --- Core ---
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# SQLite for local dev (zero setup):
DATABASE_URL=sqlite:///./caplink.db
# Postgres for production, e.g.:
# DATABASE_URL=postgresql://caplink_user:password@localhost:5432/caplink

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:3000,https://app.caplink.io,capacitor://localhost

# --- Payments ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PLATFORM_FEE_PERCENT=12.5

# --- Push notifications (mobile) ---
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json

# --- Observability ---
LOG_LEVEL=DEBUG
# Leave empty to disable error tracking (the default everywhere) — set to a
# real Sentry DSN once a Sentry project exists (see .env.staging.example).
SENTRY_DSN=

# --- Multi-tenant licensing ---
DEFAULT_UNIVERSITY_TRIAL_DAYS=30
